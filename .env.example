# Copy to .env.local. Expo CLI reads it for the app, and e2e.config.ts loads it for the test runner.

# The RevenueCat project's Test Store key (test_…): Apps and providers → Test configuration.
# Metro inlines EXPO_PUBLIC_ variables into the bundle: restart it with --clear after a change.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_...

# The tests check RevenueCat through REST API v2. A V2 secret key (sk_…): Project settings → API keys,
# with Customers read & write, Subscriptions read, and Products read.
REVENUECAT_SECRET_API_KEY=sk_...
# Project settings → General.
REVENUECAT_PROJECT_ID=proj...

# The agent's model, through the Vercel AI Gateway. Only agent steps need it.
AI_GATEWAY_API_KEY=
